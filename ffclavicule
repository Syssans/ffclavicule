#!/usr/bin/env python3
"""ffclavicule : administration du serveur de jeu FFXIV en streaming.

A lancer sur le serveur, en root (accès à Docker et au socket de Wolf) :
    sudo ./ffclavicule --help
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import tomllib
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent

DEFAULTS = {
    "FFCLAVICULE_DATA": "/srv/ffclavicule",
    "FFCLAVICULE_NAME": "ffclavicule",
    "FFXIV_IMAGE": "ffclavicule/ffxiv:latest",
    "KEYBOARD_LAYOUT": "fr",
    "FFXIV_LANGUAGE": "French",
    "XL_SECRET_PROVIDER": "NONE",
}

WOLF_SOCKET = "/var/run/wolf/wolf.sock"
WOLF_UDEV_RULES_URL = "https://raw.githubusercontent.com/games-on-whales/wolf/stable/85-wolf.rules"
MOONLIGHT_PROFILE_ID = "moonlight-profile-id"
PLAY_TITLE = "FINAL FANTASY XIV"
MAINTENANCE_TITLE = "FFXIV - Maintenance"
ICON_URL = "https://raw.githubusercontent.com/goatcorp/XIVLauncher.Core/main/misc/linux_distrib/512.png"
# Utilisateur des sessions de jeu (valeur par défaut de Wolf et des images Games on Whales).
SESSION_UID = 1000
PLAYER_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")


class CliError(Exception):
    """Erreur affichée à l'utilisateur, sans trace Python."""


# --------------------------------------------------------------------------
# Configuration (.env)
# --------------------------------------------------------------------------

def load_settings(env_file: Path = ROOT / ".env") -> dict[str, str]:
    """Valeurs par défaut, puis .env, puis variables d'environnement."""
    settings = dict(DEFAULTS)
    if env_file.exists():
        for raw in env_file.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            settings[key.strip()] = value.strip().strip('"').strip("'")
    for key in settings:
        if key in os.environ:
            settings[key] = os.environ[key]
    return settings


def data_dir(settings: dict[str, str]) -> Path:
    return Path(settings["FFCLAVICULE_DATA"])


def wolf_config_path(settings: dict[str, str]) -> Path:
    return data_dir(settings) / "wolf" / "cfg" / "config.toml"


def game_dir(settings: dict[str, str]) -> Path:
    return data_dir(settings) / "game"


# --------------------------------------------------------------------------
# Ecriture TOML (la bibliothèque standard sait lire le TOML, pas l'écrire)
# --------------------------------------------------------------------------

_BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")


def _key(k: str) -> str:
    return k if _BARE_KEY.match(k) else json.dumps(k, ensure_ascii=False)


def _value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        # Les échappements JSON sont valides dans une chaîne TOML entre guillemets.
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{_key(k)} = {_value(x)}" for k, x in v.items()) + " }"
    raise TypeError(f"Type non géré en TOML : {type(v).__name__}")


def _is_table_array(v) -> bool:
    return isinstance(v, list) and len(v) > 0 and all(isinstance(x, dict) for x in v)


def _dump_table(table: dict, path: list[str], out: list[str]) -> None:
    for k, v in table.items():
        if not isinstance(v, dict) and not _is_table_array(v):
            out.append(f"{_key(k)} = {_value(v)}")
    for k, v in table.items():
        if isinstance(v, dict):
            sub = path + [k]
            out.append("")
            out.append("[" + ".".join(_key(p) for p in sub) + "]")
            _dump_table(v, sub, out)
    for k, v in table.items():
        if _is_table_array(v):
            sub = path + [k]
            for item in v:
                out.append("")
                out.append("[[" + ".".join(_key(p) for p in sub) + "]]")
                _dump_table(item, sub, out)


def toml_dumps(data: dict) -> str:
    out: list[str] = []
    _dump_table(data, [], out)
    return "\n".join(out).lstrip("\n") + "\n"


# --------------------------------------------------------------------------
# Applications affichées dans Moonlight
# --------------------------------------------------------------------------

def session_app(settings: dict[str, str], maintenance: bool) -> dict:
    """Une appli Wolf qui démarre un conteneur de l'image FFXIV.

    maintenance=False : le jeu partagé est monté en lecture seule.
    maintenance=True  : il est monté en écriture pour l'installer ou le mettre à jour.
    """
    mode = "rw" if maintenance else "ro"
    create = {
        "HostConfig": {
            "IpcMode": "host",
            "CapAdd": ["SYS_NICE", "NET_RAW", "MKNOD", "NET_ADMIN"],
            "SecurityOpt": ["seccomp=unconfined", "apparmor=unconfined"],
            # Wine (esync) ouvre beaucoup de descripteurs de fichiers.
            "Ulimits": [{"Name": "nofile", "Hard": 524288, "Soft": 524288}],
            "Privileged": False,
            "DeviceCgroupRules": ["c 13:* rmw", "c 244:* rmw"],
        }
    }
    return {
        "title": MAINTENANCE_TITLE if maintenance else PLAY_TITLE,
        "icon_png_path": ICON_URL,
        "start_virtual_compositor": True,
        "runner": {
            "type": "docker",
            "name": "ffclavicule-maintenance" if maintenance else "ffclavicule-ffxiv",
            "image": settings["FFXIV_IMAGE"],
            "mounts": [f"{game_dir(settings)}:/ffxiv:{mode}"],
            "env": [
                "RUN_SWAY=1",
                "GOW_REQUIRED_DEVICES=/dev/input/* /dev/dri/* /dev/nvidia*",
                f"FFCLAVICULE_MODE={'maintenance' if maintenance else 'play'}",
                f"XKB_DEFAULT_LAYOUT={settings['KEYBOARD_LAYOUT']}",
                f"FFXIV_LANGUAGE={settings['FFXIV_LANGUAGE']}",
                f"XL_SECRET_PROVIDER={settings['XL_SECRET_PROVIDER']}",
            ],
            "devices": [],
            "ports": [],
            "base_create_json": json.dumps(create, indent=2),
        },
    }


def app_titles(config: dict) -> list[str]:
    for profile in config.get("profiles", []):
        if profile.get("id") == MOONLIGHT_PROFILE_ID:
            return [app.get("title", "") for app in profile.get("apps", [])]
    return []


def maintenance_enabled(config: dict) -> bool:
    return MAINTENANCE_TITLE in app_titles(config)


def configure(config: dict, settings: dict[str, str], maintenance: bool) -> dict:
    """Remplace les applis de Wolf par celles de ffclavicule.

    Le reste (appareils appairés, réglages GStreamer, uuid) est conservé.
    """
    result = dict(config)
    result["hostname"] = settings["FFCLAVICULE_NAME"]
    apps = [session_app(settings, maintenance=False)]
    if maintenance:
        apps.append(session_app(settings, maintenance=True))
    result["profiles"] = [{"id": MOONLIGHT_PROFILE_ID, "apps": apps}]
    return result


def player_from_folder(folder: str) -> str | None:
    if folder.startswith("players/"):
        return folder.split("/", 1)[1]
    return None


def check_player_name(name: str) -> str:
    if not PLAYER_NAME_RE.match(name):
        raise CliError(
            f"Nom de joueur invalide : {name!r}. "
            "Utilise des minuscules, chiffres, - ou _ (32 caractères maximum)."
        )
    return name


# --------------------------------------------------------------------------
# API de Wolf (HTTP sur socket UNIX)
# --------------------------------------------------------------------------

class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path: str, timeout: float = 10):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self) -> None:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self.unix_path)
        self.sock = sock


def wolf_api(method: str, path: str, body: dict | None = None) -> dict:
    if not os.path.exists(WOLF_SOCKET):
        raise CliError(
            f"Wolf ne répond pas ({WOLF_SOCKET} absent). "
            "Lance « sudo ./ffclavicule start » puis réessaie."
        )
    conn = _UnixHTTPConnection(WOLF_SOCKET)
    try:
        payload = json.dumps(body) if body is not None else None
        headers = {"Content-Type": "application/json"} if payload else {}
        conn.request(method, path, body=payload, headers=headers)
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8") or "{}"
    except OSError as exc:
        raise CliError(f"Impossible de joindre Wolf : {exc}") from exc
    finally:
        conn.close()
    data = json.loads(raw)
    if resp.status != 200 or data.get("success") is False:
        raise CliError(f"Wolf a refusé {path} : {data.get('error', raw)}")
    return data


def list_clients() -> list[dict]:
    return wolf_api("GET", "/api/v1/clients").get("clients", [])


def list_sessions() -> list[dict]:
    return wolf_api("GET", "/api/v1/sessions").get("sessions", [])


def set_client_player(client_id: str, player: str) -> None:
    wolf_api("POST", "/api/v1/clients/settings",
             {"client_id": client_id, "app_state_folder": f"players/{player}"})


# --------------------------------------------------------------------------
# Docker / système
# --------------------------------------------------------------------------

def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess:
    print("+ " + " ".join(cmd), flush=True)
    return subprocess.run(cmd, check=check)


def compose(*args: str) -> None:
    cmd = ["docker", "compose", "--project-directory", str(ROOT)]
    if (ROOT / ".env").exists():
        cmd += ["--env-file", str(ROOT / ".env")]
    if os.environ.get("FFCLAVICULE_NVIDIA") == "1" or (ROOT / ".nvidia").exists():
        cmd += ["-f", str(ROOT / "docker-compose.yml"), "-f", str(ROOT / "docker-compose.nvidia.yml")]
    run(cmd + list(args))


def require_root() -> None:
    if os.geteuid() != 0:
        raise CliError("Cette commande doit être lancée en root : sudo ./ffclavicule ...")


def require_docker() -> None:
    if not shutil.which("docker"):
        raise CliError("Docker est introuvable. Installe Docker Engine : https://docs.docker.com/engine/install/")


def wait_for(predicate, what: str, timeout: float = 120) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return
        time.sleep(1)
    raise CliError(f"Délai dépassé en attendant {what}. Regarde les logs : docker logs ffclavicule-wolf")


def write_wolf_config(settings: dict[str, str], maintenance: bool | None, force: bool) -> None:
    """Arrête Wolf, réécrit ses applis, le redémarre.

    Wolf ne relit sa config qu'au démarrage et la réécrit lors d'un appairage :
    il faut donc l'arrêter pendant la modification.
    """
    cfg_path = wolf_config_path(settings)
    if not cfg_path.exists():
        raise CliError(f"{cfg_path} absent : lance d'abord « sudo ./ffclavicule setup ».")

    if not force and os.path.exists(WOLF_SOCKET):
        try:
            sessions = list_sessions()
        except CliError:
            sessions = []
        if sessions:
            raise CliError(
                f"{len(sessions)} session(s) en cours : redémarrer Wolf les couperait. "
                "Réessaie plus tard ou ajoute --force."
            )

    compose("stop", "wolf")
    config = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
    if maintenance is None:
        maintenance = maintenance_enabled(config)
    shutil.copy2(cfg_path, cfg_path.with_suffix(".toml.bak"))
    cfg_path.write_text(toml_dumps(configure(config, settings, maintenance)), encoding="utf-8")
    compose("up", "-d", "wolf")
    wait_for(lambda: os.path.exists(WOLF_SOCKET), "le redémarrage de Wolf", timeout=60)


# --------------------------------------------------------------------------
# Commandes
# --------------------------------------------------------------------------

def cmd_setup(args, settings) -> None:
    require_root()
    require_docker()

    env_file = ROOT / ".env"
    if not env_file.exists():
        shutil.copy2(ROOT / ".env.example", env_file)
        print(f"Créé {env_file} (modifiable, puis relance « sudo ./ffclavicule apply »)")
        settings = load_settings()
    if args.nvidia:
        (ROOT / ".nvidia").touch()

    for dev in ("/dev/uinput", "/dev/uhid"):
        if not os.path.exists(dev):
            print(f"Attention : {dev} absent, les manettes ne fonctionneront pas (sudo modprobe {Path(dev).name}).")

    rules = Path("/etc/udev/rules.d/85-wolf.rules")
    if not rules.exists():
        print(f"Installation des règles udev de Wolf dans {rules}")
        with urllib.request.urlopen(WOLF_UDEV_RULES_URL, timeout=30) as resp:
            rules.write_bytes(resp.read())
        run(["udevadm", "control", "--reload-rules"], check=False)
        run(["udevadm", "trigger"], check=False)

    (data_dir(settings) / "wolf").mkdir(parents=True, exist_ok=True)
    game = game_dir(settings)
    game.mkdir(parents=True, exist_ok=True)
    os.chown(game, SESSION_UID, SESSION_UID)
    Path(WOLF_SOCKET).parent.mkdir(parents=True, exist_ok=True)

    cmd_build(args, settings)
    compose("pull", "wolf")
    compose("up", "-d", "wolf")
    wait_for(lambda: wolf_config_path(settings).exists(), "la création de la config de Wolf")
    write_wolf_config(settings, maintenance=True, force=True)

    print(f"""
Serveur prêt. Etapes suivantes :
  1. Sur ton appareil, installe Moonlight (https://moonlight-stream.org) et ajoute ce serveur (son adresse IP).
  2. Moonlight affiche un code PIN : sudo ./ffclavicule pair <PIN> --player <ton-nom>
  3. Lance « {MAINTENANCE_TITLE} » et connecte-toi : XIVLauncher installe le jeu dans {game}.
  4. Quand le jeu est installé : sudo ./ffclavicule maintenance off
""")


def cmd_build(args, settings) -> None:
    require_docker()
    run(["docker", "build", "--pull", "-t", settings["FFXIV_IMAGE"], str(ROOT / "image")])


def cmd_start(args, settings) -> None:
    require_root()
    compose("up", "-d", "wolf")


def cmd_stop(args, settings) -> None:
    require_root()
    compose("stop", "wolf")


def cmd_apply(args, settings) -> None:
    require_root()
    write_wolf_config(settings, maintenance=None, force=args.force)
    print("Configuration appliquée.")


def cmd_maintenance(args, settings) -> None:
    require_root()
    on = args.state == "on"
    write_wolf_config(settings, maintenance=on, force=args.force)
    if on:
        print(f"« {MAINTENANCE_TITLE} » est visible dans Moonlight : lance-le pour installer ou mettre à jour le jeu.")
        print("Personne ne doit jouer pendant une mise à jour.")
    else:
        print(f"« {MAINTENANCE_TITLE} » est retiré de Moonlight.")


def cmd_pair(args, settings) -> None:
    require_root()
    player = check_player_name(args.player)
    pending = wolf_api("GET", "/api/v1/pair/pending").get("requests", [])
    if args.ip:
        pending = [p for p in pending if p.get("client_ip") == args.ip]
    if not pending:
        raise CliError(
            "Aucun appareil en attente d'appairage. Dans Moonlight, ajoute le serveur "
            "et laisse l'écran du code PIN ouvert, puis relance cette commande."
        )
    if len(pending) > 1:
        ips = ", ".join(p.get("client_ip", "?") for p in pending)
        raise CliError(f"Plusieurs appareils en attente ({ips}) : précise lequel avec --ip.")

    before = {c["client_id"] for c in list_clients()}
    wolf_api("POST", "/api/v1/pair/client", {"pair_secret": pending[0]["pair_secret"], "pin": args.pin})

    new_ids: list[str] = []

    def paired() -> bool:
        new_ids[:] = [c["client_id"] for c in list_clients() if c["client_id"] not in before]
        return bool(new_ids)

    wait_for(paired, "la fin de l'appairage côté Moonlight (code PIN correct ?)", timeout=60)
    set_client_player(new_ids[0], player)
    print(f"Appareil {new_ids[0]} appairé pour le joueur « {player} ».")


def cmd_players(args, settings) -> None:
    require_root()
    clients = list_clients()
    if not clients:
        print("Aucun appareil appairé.")
        return
    print(f"{'APPAREIL':<22} JOUEUR")
    for c in clients:
        player = player_from_folder(c.get("app_state_folder", "")) or "(aucun : sudo ./ffclavicule assign ...)"
        print(f"{c['client_id']:<22} {player}")


def cmd_assign(args, settings) -> None:
    require_root()
    player = check_player_name(args.player)
    if args.client_id not in {c["client_id"] for c in list_clients()}:
        raise CliError(f"Appareil inconnu : {args.client_id} (voir « sudo ./ffclavicule players »).")
    set_client_player(args.client_id, player)
    print(f"L'appareil {args.client_id} utilise maintenant les données du joueur « {player} ».")


def cmd_unpair(args, settings) -> None:
    require_root()
    wolf_api("POST", "/api/v1/unpair/client", {"client_id": args.client_id})
    print(f"Appareil {args.client_id} retiré. Les données du joueur sont conservées.")


def cmd_status(args, settings) -> None:
    require_root()
    game = game_dir(settings)
    ver = game / "game" / "ffxivgame.ver"
    print(f"Jeu partagé   : {game}")
    print(f"Version       : {ver.read_text().strip() if ver.exists() else 'non installé'}")
    cfg_path = wolf_config_path(settings)
    if cfg_path.exists():
        config = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
        print(f"Maintenance   : {'activée' if maintenance_enabled(config) else 'désactivée'}")
    sessions = list_sessions()
    print(f"Sessions      : {len(sessions)}")
    for s in sessions:
        print(f"  - {s.get('client_ip', '?')}  {s.get('video_width', '?')}x{s.get('video_height', '?')}"
              f"@{s.get('video_refresh_rate', '?')}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ffclavicule", description="Serveur de jeu FFXIV en streaming.")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("setup", help="installation complète du serveur (une seule fois)")
    s.add_argument("--nvidia", action="store_true", help="carte NVIDIA (NVIDIA Container Toolkit requis)")
    s.set_defaults(func=cmd_setup)

    sub.add_parser("build", help="reconstruit l'image de session FFXIV").set_defaults(func=cmd_build)
    sub.add_parser("start", help="démarre Wolf").set_defaults(func=cmd_start)
    sub.add_parser("stop", help="arrête Wolf (coupe les sessions)").set_defaults(func=cmd_stop)

    s = sub.add_parser("apply", help="réapplique .env à la config de Wolf (redémarre Wolf)")
    s.add_argument("--force", action="store_true", help="même si des sessions sont en cours")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("maintenance", help="affiche ou retire l'appli d'installation/mise à jour du jeu")
    s.add_argument("state", choices=["on", "off"])
    s.add_argument("--force", action="store_true", help="même si des sessions sont en cours")
    s.set_defaults(func=cmd_maintenance)

    s = sub.add_parser("pair", help="appaire un appareil Moonlight et l'attribue à un joueur")
    s.add_argument("pin", help="code PIN affiché par Moonlight")
    s.add_argument("--player", required=True, help="nom du joueur (ses réglages et son Wine lui sont propres)")
    s.add_argument("--ip", help="IP de l'appareil, si plusieurs attendent en même temps")
    s.set_defaults(func=cmd_pair)

    sub.add_parser("players", help="liste les appareils et leur joueur").set_defaults(func=cmd_players)

    s = sub.add_parser("assign", help="attribue un appareil déjà appairé à un joueur")
    s.add_argument("client_id")
    s.add_argument("player")
    s.set_defaults(func=cmd_assign)

    s = sub.add_parser("unpair", help="retire un appareil")
    s.add_argument("client_id")
    s.set_defaults(func=cmd_unpair)

    sub.add_parser("status", help="version du jeu et sessions en cours").set_defaults(func=cmd_status)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        args.func(args, load_settings())
    except CliError as exc:
        print(f"Erreur : {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        print(f"Erreur : la commande {' '.join(exc.cmd)} a échoué (code {exc.returncode}).", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
