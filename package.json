    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.12",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "node scripts/ensure-expo-env.js && tsc --noEmit",
    "donnees:collect": "node scripts/update-collect-reference.mjs",
    "donnees:peche": "node scripts/update-fishing-data.mjs",
    "donnees:recolte": "node scripts/update-gathering-data.mjs",
    "donnees:carte": "node scripts/update-map-data.mjs",
    "donnees:objets": "node scripts/update-items-index.mjs",
    "donnees:legende": "node scripts/update-lore-data.mjs",
    "donnees:chasse": "node scripts/update-hunt-data.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^three$": "<rootDir>/node_modules/three/build/three.module.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|three|@react-three))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
