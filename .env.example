# Copié en .env par « sudo ./ffclavicule setup ». Après modification : sudo ./ffclavicule apply

# Dossier du serveur : game/ (le jeu, partagé par tous) et wolf/ (config + données des joueurs)
FFCLAVICULE_DATA=/srv/ffclavicule

# Nom du serveur affiché dans Moonlight
FFCLAVICULE_NAME=ffclavicule

# Disposition du clavier dans les sessions (fr, us, be, ch...)
KEYBOARD_LAYOUT=fr

# Langue du jeu par défaut : French, English, German, Japanese
FFXIV_LANGUAGE=French

# Mots de passe Square Enix dans XIVLauncher :
#   NONE : jamais enregistrés (le joueur les tape à chaque connexion)
#   FILE : enregistrés en clair dans le dossier du joueur sur le serveur
XL_SECRET_PROVIDER=NONE

# Images Docker
FFXIV_IMAGE=ffclavicule/ffxiv:latest
WOLF_IMAGE=ghcr.io/games-on-whales/wolf:stable
